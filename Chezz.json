  "components": {
    "schemas": {
      "AccessTokenResponse": {
        "required": [
          "accessToken",
          "expiresIn",
          "refreshToken"
        ],
        "type": "object",
        "properties": {
          "tokenType": {
            "type": "string",
            "nullable": true,
            "readOnly": true
          },
          "accessToken": {
            "type": "string",
            "nullable": true
          },
          "expiresIn": {
            "type": "integer",
            "format": "int64"
          },
          "refreshToken": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ChessGameState": {
        "required": [
          "board",
          "yourColor",
          "yourTurn"
        ],
        "type": "object",
        "properties": {
          "board": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/ChessPiece"
                  }
                ],
                "nullable": true
              }
            },
            "nullable": true
          },
          "yourTurn": {
            "type": "boolean"
          },
          "yourColor": {
            "$ref": "#/components/schemas/PieceColor"
          }
        },
        "additionalProperties": false
      },
      "ChessMove": {
        "type": "object",
        "properties": {
          "from": {
            "$ref": "#/components/schemas/ChessPosition"
          },
          "to": {
            "$ref": "#/components/schemas/ChessPosition"
          }
        },
        "additionalProperties": false
      },
      "ChessPiece": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/ChessPieceEnum"
          },
          "playerId": {
            "type": "string",
            "nullable": true
          },
          "color": {
            "$ref": "#/components/schemas/PieceColor"
          },
          "imageUrl": {
            "type": "string",
            "nullable": true,
            "readOnly": true
          }
        },
        "additionalProperties": false
      },
      "ChessPieceEnum": {
        "enum": [
          "Pawn",
          "Knight",
          "Bishop",
          "Rook",
          "Queen",
          "King"
        ],
